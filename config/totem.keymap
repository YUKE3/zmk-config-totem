//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5
#define NAV2 6

/ {
    behaviors {
        // Seniply / Callum one-shot mods (QMK OSM). Stock ZMK &sk, named so
        // the settings stay off the default sticky key.
        //
        // Tap: the modifier stays armed until the next non-modifier keycode.
        // Layer changes do not clear it. &mo, and the hold of &lt, send no
        // keycode, so you can arm a mod on NAV, then hold SYM / ADJ / a
        // function layer, or release NAV and type on base.
        // Hold: chords like a normal modifier for as long as the key is down.
        // Once another key was pressed while it was held, releasing it does
        // not leave a one-shot behind.
        //
        // Taps stack (Ctrl, then Shift, then A is Ctrl+Shift+A). A second tap
        // of the same mod refreshes it; it does not cancel. `lazy` keeps an
        // unused tap off the host, so a GUI tap that times out does not open
        // the OS menu. `&kp LGUI` on NAV (D) is the key that taps Super alone.
        //
        // release-after-ms cannot be 0. This ZMK build (v0.3) treats 0 as
        // already expired and drops the modifier when the next key arrives,
        // instead of applying it. 5000 is QMK's default one-shot timeout.

        osm: one_shot_mod {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "One-shot mod";
            bindings = <&kp>;
            release-after-ms = <5000>;
            quick-release;
            lazy;
            ignore-modifiers;
        };

        // Symbol-layer arrow. Shift and Alt select the variant, then are
        // masked so they don't alter the characters. Alt+Shift masks both
        // in the last step; a nested morph can only mask one set per step.
        //   ->    Shift =>    Alt <->    Alt+Shift <=>
        arr_r: arrow_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "->";
            bindings = <&macro_tap &kp MINUS &kp GREATER_THAN>;
        };
        arr_fat: arrow_fat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "=>";
            bindings = <&macro_tap &kp EQUAL &kp GREATER_THAN>;
        };
        arr_lr: arrow_left_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "<->";
            bindings = <&macro_tap &kp LESS_THAN &kp MINUS &kp GREATER_THAN>;
        };
        arr_eq: arrow_both {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "<=>";
            bindings = <&macro_tap &kp LESS_THAN &kp EQUAL &kp GREATER_THAN>;
        };

        arr_nos: arrow_no_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&arr_r>, <&arr_lr>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        // Reached only while Shift is already held. Masks Shift and Alt together.
        arr_mask: arrow_shift_alt_mask {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&arr_fat>, <&arr_eq>;
            mods = <(MOD_LSFT|MOD_RSFT|MOD_LALT|MOD_RALT)>;
        };
        arr_s: arrow_with_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&arr_fat>, <&arr_mask>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        arr: arrow {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Arrow";
            bindings = <&arr_nos>, <&arr_s>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <2 1>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
          &kp Q  &kp W  &kp F         &kp P  &kp B        &kp J           &kp L  &kp U         &kp Y    &kp SINGLE_QUOTE
          &kp A  &kp R  &kp S         &kp T  &kp G        &kp M           &kp N  &kp E         &kp I    &kp O
&kp BSPC  &kp Z  &kp X  &kp C         &kp D  &kp V        &kp K           &kp H  &kp COMMA     &kp DOT  &kp FSLH          &kp RET
                        &lt 5 ESCAPE  &mo 1  &kp SPACE    &kp LEFT_SHIFT  &mo 2  &lt 4 DELETE
            >;
        };

        nav_layer {
            label = "NAVI";

            bindings = <
        &none      &none      &none       &none       &none        &none         &none     &none          &none        &none
        &osm LGUI  &osm LALT  &osm LCTRL  &osm LSHFT  &osm RALT    &kp CAPSLOCK  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)   &kp LC(V)    &none    &kp INSERT    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
                              &trans      &none       &trans       &trans        &mo 3     &trans
            >;
        };

        num_layer {
            label = "SYM";
            bindings = <
        &kp SLASH  &kp N7  &kp N8     &kp N9  &kp ASTRK       &none   &none      &none          &none             &none
        &kp MINUS  &kp N4  &kp N5     &kp N6  &kp PLUS        &none   &kp LSHFT  &kp LCTRL      &kp RALT          &kp RIGHT_GUI
&trans  &kp X      &kp N1  &kp N2     &kp N3  &kp PERCENT     &none   &none      &kp LESS_THAN  &kp GREATER_THAN  &kp FSLH       &trans
                           &kp UNDER  &mo 3   &kp NUMBER_0    &trans  &none      &trans
            >;
        };

        symbol_layer {
            label = "ADJ";
            bindings = <
        &kp GRAVE  &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE         &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &arr
        &kp EXCL   &kp ASTERISK   &lt NAV2 EQUAL    &mt LSHFT SLASH    &kp AMPERSAND    &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES
&trans  &kp TILDE  &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT      &kp AT_SIGN  &kp COLON             &kp COMMA              &kp DOT        &kp SQT            &trans
                                  &none             &none              &none            &none        &none                 &none
            >;
        };

        FUNCTION_LAYER {
            label = "TVP 1";
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &none     &none   &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &none
        &kp F11  &kp F4  &kp F5  &kp F6  &none     &none   &kp RSHFT        &kp RCTRL       &kp RALT         &kp RGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &none     &none   &none            &none           &none            &none     &trans
                         &trans  &trans  &trans    &trans  &trans           &none
            >;
        };

        zmk_layer {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans
                &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &bt BT_CLR    &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                            &none         &trans        &trans          &trans  &trans  &trans
            >;
        };

        nav_hold_layer {
            label = "NAV2";
            // Same keys as NAV, above the symbol layer, so holding = can
            // show nav while the symbol layer is still held.
            bindings = <
        &none      &none      &none       &none       &none        &none         &none     &none          &none        &none
        &osm LGUI  &osm LALT  &osm LCTRL  &osm LSHFT  &osm RALT    &kp CAPSLOCK  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)   &kp LC(V)    &none    &kp INSERT    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
                              &trans      &none       &trans       &trans        &mo 3     &trans
            >;
        };
    };
};
