#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

/ {
    behaviors {
        // Seniply / Callum one-shot mods (QMK OSM). Stock ZMK &sk, named so
        // the settings stay off the default sticky key.
        //
        // Tap: the modifier stays armed until the next non-modifier keycode.
        // Layer changes do not clear it. &mo, and the hold of &lt, send no
        // keycode, so you can arm a mod on NAV, then hold SYM / ADJ / a
        // function layer, or release NAV and type on base.
        // Hold: chords like a normal modifier for as long as the key is down.
        // Once another key was pressed while it was held, releasing it does
        // not leave a one-shot behind.
        //
        // Taps stack (Ctrl, then Shift, then A is Ctrl+Shift+A). A second tap
        // of the same mod refreshes it; it does not cancel. `lazy` keeps an
        // unused tap off the host, so a GUI tap that times out does not open
        // the OS menu. `&kp LGUI` on NAV (D) is the key that taps Super alone.
        //
        // release-after-ms cannot be 0. This ZMK build (v0.3) treats 0 as
        // already expired and drops the modifier when the next key arrives,
        // instead of applying it. 5000 is QMK's default one-shot timeout.
        osm: one_shot_mod {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "One-shot mod";
            bindings = <&kp>;
            release-after-ms = <5000>;
            quick-release;
            lazy;
            ignore-modifiers;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <2 1>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
          &kp Q  &kp W  &kp F  &kp P  &kp B        &kp J  &kp L  &kp U  &kp Y  &kp SINGLE_QUOTE
          &kp A  &kp R  &kp S  &kp T  &kp G        &kp M  &kp N  &kp E  &kp I  &kp O
&kp BSPC  &kp Z            &kp X            &kp C                &kp D              &kp V        &kp K  &kp H               &kp COMMA     &kp DOT           &kp FSLH          &kp RET
                                            &lt 5 ESCAPE         &mo 1              &kp SPACE    &mo 3  &mo 2               &lt 4 DELETE
            >;
        };

        nav_layer {
            label = "NAVI";
            // Home row, same fingers as the old home-row mods, plus AltGr on G:
            //   tap &osm to arm it, or hold it to chord with arrows / another layer.
            // D (&kp LGUI) taps Super by itself. &osm LGUI will not, because it is lazy.
            bindings = <
        &none      &none      &none       &none       &none      &none         &none     &none          &kp INSERT   &none
        &osm LGUI  &osm LALT  &osm LCTRL  &osm LSHFT  &osm RALT  &kp CAPSLOCK  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&trans  &none      &none      &none       &kp LGUI    &none      &none         &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
                               &trans      &none       &trans     &trans        &trans    &trans
            >;
        };

        num_layer {
            label = "SYM";
            bindings = <
        &kp GRAVE      &kp N7  &kp N8      &kp N9        &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp LBKT   &kp RBKT       &kp COLON         &none
        &kp SEMICOLON  &kp N4  &kp N5      &kp N6        &kp MINUS         &kp SQT          &kp LSHFT  &kp LCTRL      &kp RALT          &kp RIGHT_GUI
&trans  &kp BACKSLASH  &kp N1  &kp N2      &kp N3        &kp PLUS          &kp QUESTION     &kp EQUAL  &kp LESS_THAN  &kp GREATER_THAN  &kp FSLH       &trans
                               &kp PERIOD  &kp NUMBER_0  &kp UNDERSCORE    &trans           &none      &trans
            >;
        };

        symbol_layer {
            label = "ADJ";
            bindings = <
        &kp TILDE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS   &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none             &none
        &kp COLON  &kp DOLLAR       &kp PERCENT   &kp CARET              &kp MINUS         &kp DOUBLE_QUOTES  &kp RIGHT_SHIFT   &kp RCTRL          &kp RIGHT_ALT     &kp RIGHT_META
&trans  &kp PIPE   &kp EXCLAMATION  &kp AT_SIGN   &kp POUND              &kp PLUS          &kp QUESTION       &kp EQUAL         &kp LESS_THAN      &kp GREATER_THAN  &kp SLASH       &trans
                                    &trans        &kp RIGHT_PARENTHESIS  &kp UNDERSCORE    &none              &trans            &trans
            >;
        };

        FUNCTION_LAYER {
            label = "TVP 1";
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &none     &none   &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &none
        &kp F11  &kp F4  &kp F5  &kp F6  &none     &none   &kp RSHFT        &kp RCTRL       &kp RALT         &kp RGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &none     &none   &none            &none           &none            &none     &trans
                         &trans  &trans  &trans    &trans  &trans           &none
            >;
        };

        zmk_layer {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans
                &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &bt BT_CLR    &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                            &none         &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
